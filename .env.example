# ── Copy this file to .env and fill in your keys ──────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional)
GOOGLE_API_KEY=AIza...

# Tavily (web search used by LangGraph agents)
TAVILY_API_KEY=tvly-...

# LangSmith tracing (optional but recommended for multi-agent debugging)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=multi-agent-web-research
