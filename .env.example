# ── Multi-Agent Web Research Team Environment Configuration ───────────────────

# ── Primary Recommended LLM (Groq Cloud - Ultra Fast & Free) ─────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Alternative Cloud Providers ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ── Web Search Providers ──────────────────────────────────────────────────────
# Note: DuckDuckGo live search works with zero API keys required!
# Optional Tavily search key if you want dual-provider search:
TAVILY_API_KEY=tvly-...

# ── Server Config ─────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
DEFAULT_TEMPERATURE=0.2
MAX_ITERATIONS=2
